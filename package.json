{
  "name": "iranbanks",
  "version": "2.1.0",
  "description": "Detect Iranian banks from card numbers - Fast, lightweight, and reliable BIN lookup for Iranian banking system",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test test.js",
    "icons:import": "node scripts/import-icons.js"
  },
  "keywords": [
    "iran",
    "iranian",
    "bank",
    "card",
    "detection",
    "bin",
    "lookup",
    "persian",
    "farsi",
    "financial",
    "payment",
    "validation",
    "بانک",
    "کارت",
    "ایران",
    "svg",
    "logo",
    "sheba",
    "شبا"
  ],
  "author": "Masoud Vafaei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masoudv/iranbanks.git"
  },
  "devDependencies": {
    "svgo": "^3.3.5"
  },
  "files": [
    "index.js",
    "browser.js",
    "core.js",
    "banks.js",
    "index.d.ts",
    "banks.d.ts",
    "icons/",
    "README.md"
  ],
  "browser": "browser.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./browser": {
      "types": "./index.d.ts",
      "default": "./browser.js"
    },
    "./browser.js": {
      "types": "./index.d.ts",
      "default": "./browser.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./banks": {
      "types": "./banks.d.ts",
      "default": "./banks.js"
    },
    "./banks.js": {
      "types": "./banks.d.ts",
      "default": "./banks.js"
    },
    "./icons/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=14"
  }
}
